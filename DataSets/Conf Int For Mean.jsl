clear globals();namesdefault to here (1);datamat = 0;mn = origmn = 0;numbins = 15;stdv = origstdv = 1;varname = origvarname = "Height";n = orign = 25;rep = origrep = 1;bagofmeans = bagofstdv = bagoflowers = bagofuppers = bagofcovers = [.];sampnum = 0;  //cumulative sample countpoptype = 1; //normalmsm = .;stdvsm = .;lcl = ucl = .;conf = .95;sigma = 1;bins1 = .;bins3 = .;nqs = .;parmval = (evallist({char(origmn), char(origstdv), origvarname, char(orign), char(origrep), char(conf)}));use_sigma = 0;updateall = expr(	plotsample;	plotcis; 	samplecidetails;	updatesummary;);resetsamples = expr(	try(gb1 << delete); try(gb2<<delete); try(gb3<<delete);	golb1 << append(gb1 = graph box(frame size(450,150), xname(parmval[3]), yscale(0, num(parmval[4])/2),xscale(mn-4*stdv, mn+4*stdv)));	golb1[axisbox(1)]<<removeaxislabel;	{ymin, ymax} = mn + {-1, 1} * 3*if(use_sigma==1,stdv/sqrt(n)*normalquantile(.5+conf/2), stdv/sqrt(n)*tquantile(.5+conf/2, n-1));		golb3 << append(gb3 = graph box(frame size(450,150), yscale(ymin, ymax), xname("Sample Number"), hline(mn)));	golb3[axisbox(1)]<<removeaxislabel;	msttb1 << settext(".");	msttb2 << settext(".");	msttb3 << settext(".");	ssttb1 << settext(".");	ssttb2 << settext(".");	ssttb3 << settext(".");	bagofmeans = bagofstdv = bagofuppers = bagoflowers = bagofcovers = [.];	sampnum = 0;	cipcttb <<settext(". %Include Population Mean");	try(cihlb << delete);	ciolb << append(		cihlb = h list box(			number col box("      Sample", {.}),			number col box("     Estimate", {.}),			if(use_sigma, numbercolbox("Sample Std Dev", {.})),			number col box("      Lower CI", {.}),			number col box("     Upper CI", {.}),			number col box("         Alpha", {1-conf}),			number col box("         Sigma", {sigma})		)	);	);getuserdata = Function( {dt},	{Default Local},	If( Is Empty( dt ),		Try( dt = Open() );		If( Is Empty( dt ),			New Window( ,				modal,				Text Box( 					"No Data Table Selected. Script Terminating." 				)			);			stop();		);	);	nc = N Col( dt );	If( nc == 1,		m = Column( 1 ) << get values;	,		res = Column Dialog(			c1 = ColList( "Pick a Numeric Column:", datatype(numeric), Max Col( 1 ), Min Col(1) ),		);		If( res["button"] == 1,			m = res["c1"][1] << get values;		,			New Window( , modal,				Text Box("No Column Selected. Script Terminating.")			);			stop();		);	);	evallist({m, mean(m), stddev(m)}););plotsample = expr(	try(gb1<<delete);	bins1 = J(numbins,1,0);	minsample = min(sample);	xmin1 = mn-4*stdv; 	xmax1 = mn+4*stdv;	width1 = (xmax1-xmin1)/numbins;	for(i1 = 1, i1<= n, i1++,		bins1[min(max(1,ceiling((sample[i1]-minsample)/width1)), numbins)]++;	);	golb1 << append(		gb1 = graphbox(			framesize(450, 150),			xscale (xmin1, xmax1),			yscale(0, max(.5*n,max(bins1)*1.25)),			pencolor("black"),			fill color("Green"),			for(i1 = 1, i1<=numbins, i1++,				rect(					minsample+(i1-1)*width1,					bins1[i1],					minsample+i1*width1,					0,					1				);				rect(					minsample+(i1-1)*width1,					bins1[i1],					minsample+i1*width1,					0,					0				)			);		)	);	golb1[axisbox(1)]<<removeaxislabel;	golb1[axisbox(2)]<<removeaxislabel<<addaxislabel(parmval[3]););getnextsamples = expr(	conf = num(parmval[6]);	dist = cb1<<get;	rep = num(parmval[5]);	mn = num(parmval[1]);	stdv = num(parmval[2]);	n = num(parmval[4]);	for (i = 1, i <= rep, i++,		sampnum+=1;		choose(dist,			//Normal			sample = J(n,1,randomnormal(mn, stdv)),			//Skewed Right			sample = J(n,1,randomexp())*stdv+(mn-stdv),			//Uniform			sample = J(n,1,randomuniform(-sqrt(3), sqrt(3)))*stdv+mn,			//My Data			nr = nrow(datamat);			mxrw = floor(.10*nr);			If(n > mxrw,				ErrMsg("Invalid Sample Size:\!NSample exceeds 10% of Population.\!N\!NSample Size set to " ||char(mxrw)||".");				parmval[4] = char(mxrw);				teb4 << settext(parmval[4]);				n = num(parmval[4]);				sample = datamat[rankindex(J(nr,1, randomuniform()))][1::n, 1::1]; 			,				sample = datamat[rankindex(J(nr,1, randomuniform()))][1::n, 1::1]; 			)		);		sm = mean(sample);		sstdv = stddev(sample);		{lower, upper} = sm + {-1, 1} * if(use_sigma,stdv/sqrt(n)*normalquantile(.5+conf/2), sstdv/sqrt(n)*tquantile(.5+conf/2, n-1));			cover = lower < mn < upper;		if(sampnum==1,			bagofmeans[1] = matrix(sm);			bagofstdv[1] = matrix(sstdv);			bagofuppers[1] = matrix(upper);			bagoflowers[1] = matrix(lower);			bagofcovers[1] = matrix(cover)		, 			bagofmeans |/= matrix(sm);			bagofstdv |/= matrix(sstdv);			bagofuppers |/= matrix(upper);			bagoflowers |/= matrix(lower);			bagofcovers |/= matrix(cover)		);		if(animate_f, updateall; wait(.05));	);		msm = mean(bagofmeans);	stdvsm = stddev(bagofmeans);	if(!(animate_f), updateall););plotcis = expr(		try(gb3<<delete);	{ymin, ymax} = mn + {-1, 1} * 3*if(use_sigma==1,stdv/sqrt(n)*normalquantile(.5+conf/2), stdv/sqrt(n)*tquantile(.5+conf/2, n-1));		golb3 << append(		gb3 = graphbox(			framesize(450, 150),			xname("Sample Number"),			xscale (max(0, sampnum-100), max(100, sampnum)),			yscale(ymin, ymax),			for(i3 = 1, i3<=sampnum, i3++,				choose(bagofcovers[i3]+1, pencolor("red"), pencolor("green"));				vline(i3, bagoflowers[i3], bagofuppers[i3])			);			pen color("Gray");			hline(mn);		)	);	cipcttb << settext(char(round(mean(bagofcovers)*100,2))||"% Include Population Mean");	golb3[axisbox(1)]<<removeaxislabel;);samplecidetails = expr(	try(cihlb << delete);		ciolb << append(		cihlb = h list box(			number col box("      Sample", {sampnum}),			number col box("     Estimate", {sm}),			if(use_sigma, numbercolbox("Sample Std Dev", {sstdv})),			number col box("      Lower CI", {lower}),			number col box("     Upper CI", {upper}),			number col box("         Alpha", {1-conf}),			number col box("         Sigma", {sigma})		)	););updatesummary = expr(	msttb1 << settext(char(round(mean(bagofmeans), 4)));	msttb2 << settext(char(round(stddev(bagofmeans), 4)));	msttb3 << settext(char(round(nrows(bagofmeans), 4)));	ssttb1 << settext(char(round(mean(sample), 4)));	ssttb2 << settext(char(round(stddev(sample), 4)));	ssttb3 << settext(char(round(nrows(bagofmeans), 4))););createtable = expr(	r = J(sampnum,1,.);	for(i = 1, i<=sampnum, i++,		r[i]=i;	);	dt = astable(r||bagofmeans||bagofstdv);    dt << set  name("Sample Data");    column(dt, 1)<<set name("Sample") <<  set field width(20);    column(dt, 2)<<set name("Sample Mean") <<  set field width(20);    column(dt, 3)<<set name("Sample Stdv") <<  set field width(20););createhistogram = expr(	dt = choose(cb1 << get,		//Normal		astable(J(10000,1,randomnormal(mn,stdv))),		//Skewed Right		astable(J(10000,1,randomexp())*stdv+(mn-stdv)),		//Uniform		astable(J(10000,1,randomuniform(-sqrt(3), sqrt(3)))*stdv+mn),		//My Data		astable(datamat); 	);	varname = parmval[3];	dt << set name("Population Data");	column(dt,1) << set name(varname);	Eval(Parse(Substitute("dt << Distribution(		Continuous Distribution(			Column( eval(varname) ),			Quantiles( 0 ),			Vertical( 0 ),			Outlier Box Plot( 0 )		),		SendToReport(			Dispatch(				{iii},				\!"Distrib Histogram\!",				FrameBox,				{Frame Size( 500, 200 )}			)		)	);", 	"iii", varname)));	);useParm = Function( {p,v},	If( checkParm( p, v ), 		parmVal[p] = v;		//updateall;	,		inputvlb[Text Edit Box( p )] << Set Text( Char( parmVal[p] ) );		errmsg(			choose(p,				"Mean must be numeric.",				"Standard Deviation must be positive.",				"", //this error should not be possible				"Sample Size must be a positive integer.",				"Number of samples must be a positive integer.",				"Confidence level must be between 0 and 1"			)		)	));checkParm = Function( {p, v},	If( Not( Is Missing( v ) ),		Choose( p,			// Mean			!ismissing(num(v)),			// Stdv			!ismissing(num(v))& num(v) > 0, 			// Name			1, 			// Sample Size			!ismissing(num(v))& num(v) == Floor( num(v) ) & num(v) > 0,			// N			!ismissing(num(v))& num(v) == Floor( num(v) ) & num(v) > 0,			// Confidence Level			!ismissing(num(v))& 0 < num(v) < 1		) 	,		0	));errmsg = function(	{errtxt},	{},	new window("Error!", modal(1),		Text Box(errtxt),	););showhelp = expr(New Window( "Help",               H List Box(                    Text Box( "  " ), // left margin                    V List Box(                           tbHeader# = Text Box( "Confidence Interval for the Population Mean", << set wrap (600)),                           Text Box( " " ),                                                      Text Box( "Explore confidence intervals for the population mean for different confidence levels, population shapes, means, standard deviations and sample sizes. ", << set wrap (600)),                                                      Text Box( " " ),                                                      tbUses# = Text Box( "Suggested Use" ),                           Text Box( " " ),                                                      Text Box( "Click 'Draw Samples' to draw one sample at the default values.", << set wrap (600)),                                                      Text Box( " " ),                                                      Text Box( "Change the 'Number of Samples' to draw more than one sample at a time.", << set wrap (600)),                                                      Text Box( " " ),                                                      Text Box( "Click 'Reset Samples' to clear the previously drawn samples.", << set wrap (600)),                                                      Text Box( " " ),                                                      Text Box( "Change the 'Sample Size' to explore confidence intervals for different sample sizes." , << set wrap (600)),                                                      Text Box( " " ),                                                      Text Box( "Change the 'Confidence Level' to explore confidence intervals and the percentage of intervals that include the specified population mean for different confidence levels.", << set wrap (600) ),                                                      Text Box( " " ),                                                      Text Box( "Change the 'Population Mean' and 'Population Standard Deviation' to explore confidence intervals for different population means and standard deviations.", << set wrap (600)),                                                      Text Box( " " ),                                                      Text Box( "Change the 'Population Shape' to explore the confidence intervals for different distributions. ", << set wrap (600)),                                                      Text Box( " " ),                                                      tbNotes# = Text Box( "Design Notes" ),                          Text Box( " " ),                           tbPop# = Text Box( "Population Characteristics" ),                          Text Box( " " ),                          Text Box( "'Population Shape' - Specify Normal, Skewed Right, Uniform, or My Data.", << set wrap (600)),                                                     Text Box( " " ),                          H List Box(Text Box( "   " ),Text Box( "Note:  My Data prompts to open a data table.  Select a data table, and then select the continuous variable of interest.  The mean and standard deviation from the data table will become the population mean and standard deviation, and JMP randomly sample without replacement up to 10% of the data table. ", << set wrap (600) )),                           Text Box( " " ),                                                      Text Box( "'Population Mean' and 'Population Standard Deviation' - The underlying (true) population mean and standard deviation. ", << set wrap (600)),                                                      Text Box( " " ),                                                      Text Box( "'Name of Variable' - The name of the variable of interest. ", << set wrap (600)),                                                      Text Box( " " ),                                                      tbDemo# = Text Box( "Demo Characteristics" ),                          Text Box( " " ),                          Text Box( "'Sample Size' - The sample size randomly drawn from the population. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Number of Samples' - The number of samples randomly drawn from the population. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Confidence Level' - The 1- alpha confidence level for the calculated confidence intervals. ", << set wrap (600)),                          Text Box( " " ),                          H List Box(Text Box( "   **" ),Text Box( "Note:  Sample data will not reset when the confidence level is changed to allow for direct comparison of confidence interval widths at different confidence levels.  The Percentage of Confidence Intervals Containing the Population Mean WILL NOT BE VALID (it will not reflect the confidence level).", << set wrap (600) )),                          Text Box( " " ),                          Text Box( "'Use known Population Std Dev?' - Yes (use the population standard deviation to calculate the confidence intervals) or No (use the calculated sample standard deviations).", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Animate Illustration?' - Show each sample drawn (Yes) or quickly draw all samples (No). ", << set wrap (600)),                          Text Box( " " ),                           tbRunSim# = Text Box( "Run Simulation" ),                          Text Box( " " ),                          Text Box( "'Draw Samples' - Generates the specified number of samples at the given sample size. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Reset Samples' - Clear all sample data.  Does not change Population or Demo Characteristics.  Sample Data will reset when Population Characteristics, the Sample Size, or Use Known Population Std Dev? are changed.", << set wrap (600)),                          Text Box( " " ),                           tbPopData# = Text Box( "Population Data" ),                          Text Box( " " ),                          Text Box( "'Create Histogram' - Creates a histogram of 10,000 observations randomly drawn from the specified population.  If the Population Shape is My Data, displays a histogram of the variable selected.", << set wrap (600)),                          Text Box( " " ),                           tbTable# = Text Box( "JMP Data Table" ),                          Text Box( " " ),                          Text Box( "'Create Data Table' - Creates a data table of the collected sample statistics and confidence intervals. ", << set wrap (600)),                          Text Box( " " ),                           tbGraphs# = Text Box( "Graphs and Statistics" ),                          Text Box( " " ),                          Text Box( "'Distribution of Sample Data' - Displays the distribution of the last sample drawn. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Sample Confidence Interval' - Summary statistics and the confidence interval for the last sample drawn. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Confidence Intervals for Population Mean' - Displays confidence intervals for all samples. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Percentage of Confidence Intervals Containing the Population Mean' - The percentage of calculated confidence intervals that include the specified population mean. ", << set wrap (600)),                          Text Box( " " ),                          Text Box( "'Sample Summary Table' - Provides summaries of the last sample drawn. ", << set wrap (600)),                          Text Box( " " ),                          Button Box( "Close",                               Window( "Help" ) << Close Window;                          ),                    //   Text Box( " " ),                          Text Box( "Copyright © 2009-2012 SAS Institute Inc." )                    ),                    Text Box( "  " )     // right margin               )          );        {tbHeader#} 				<< Set Font( "Arial Black" ) 				<< Set Font Style( "Bold" ) 				<< Set Font Size( 18 );		{tbUses#, tbNotes#} 				<< Set Font( "Arial Black" ) 				<< Set Font Style( "Bold" ) 				<< Set Font Size( 16 );		{tbPop#, tbDemo#, tbRunSim#, tbPopData#, tbTable#, tbGraphs#} 				<< Set Font( "Arial Black" ) 				<< Set Font Size( 14 ););showinfo = expr(	New Window("More Information",		hlistbox(			spacerbox(size(20,20)),			VlistBox(				HListBox(					VlistBox(						Text Box("\!NThis interactive module was developed by Amy Froelich of Iowa State University, Bill duckworth of Creighton University, Predictum, Inc and the JMP Academic team. It was programmed by Brady Brady of JMP.")),					spacerbox(size(100, 5)),					vlistbox(						spacerbox(size(5,25)),						ButtonBox("www.jmp.com", web("www.jmp.com")),						spacerbox(size(5,30)),						Button Box("www.jmp.com/academic", web("www.jmp.com/academic")),						spacerbox(size(5,30)),						buttonbox("Close this window", window("More Information") << closewindow;)					)				),				textbox("                      Copyright (c) 2008-2012 SAS Institute, Inc.", << set wrap(600))			)		)	));openwindow = expr(	nw = new window("Confidence Intervals for the Population Mean",		H List Box(			inputvlb = v list box(				outline box("Population Characteristics",					lineup box(ncol(2),						Text Box("Population Shape:"),						cb1 = Combo Box({"Normal", "Skewed Right", "Uniform", "My Data"},							If (cb1 << get == 4,								{datamat, mn, stdv} = getuserdata(currentdatatable());								parmval[1] = char(mn); teb1 << settext(char(round(mn,4)));								parmval[2] = char(stdv); teb2 << settext(char(round(stdv,4)));							);							choose(cb1 << get,								txt = "Height",								txt = "Count",								txt = "Time",								txt = "Data"							);							teb3 << settext(txt);							parmval[3] = txt;							gb1[axisbox(2)]<<removeaxislabel<<addaxislabel(txt);							resetsamples;						),						Text Box("Population Mean:"),						teb1 = Text Edit Box(parmval[1], 							<< script(								old = num(parmval[1]);								if(useparm(1, teb1 << gettext) != old, resetsamples);							)						),						Text Box("Population Standard Deviation:  "), 						teb2 = Text Edit Box(parmval[2],							<< script(								old = num(parmval[2]);								if(useparm(2, teb2 << gettext) != old, resetsamples);							)						),						Text Box("Name of Variable:"), 						teb3 = Text Edit Box(parmval[3],							<< script(								useparm(3, teb3 << gettext);								newtext = teb3 << gettext;								parmval[3] = newtext;								gb1[axisbox(2)]<<remove axis label << add axis label(newtext);							)						)					)				),				Outline Box("Demo Characteristics",					lineup Box(ncol(2),						Text Box("Sample Size:"), 						teb4 = Text Edit Box(parmval[4],							<< script(								old = num(parmval[4]);								if(useparm(4, teb4 << gettext) != old, 									resetsamples;									n = num(parmval[4]);								);							)						),						Text Box("Number of Samples:  "), 						teb5 = Text Edit Box(parmval[5],							<< script( 								useparm(5, teb5 << gettext);							)						),						Text Box("Confidence Level:"),						teb6 = Text Edit Box (parmval[6],							<< script(								useparm(6, teb6 << gettext);							)						),						Text Box("Use known Population Std Dev?"),						rb1 = Radio Box(							{"Yes", "No"},							<< set(2),							use_sigma = mod(rb1<<get, 2);							resetsamples;						),						Text Box("Animate Illustration? "), 						rb2 = radio box(							{"Yes", "No"}, 							<< set(2),							animate_f = mod(rb2<<get,2)						)					)				),				outline box("Run Simulation",					H List Box(						Button Box("Draw Additional Samples",							getnextsamples;						),						Button Box("Reset Samples",							resetsamples;						)					)				),				Outline Box("JMP Data Table",					Button Box("Create Data Table",						createtable;					)				),				Outline Box("Population Data",					Button Box("Create Histogram",						createhistogram;					)				),				H List Box(					Button Box("Help", showhelp),					Button Box("More Information", showinfo),					Button Box("Restart Demo", 						window("Confidence Intervals for the Population Mean")<<closewindow;						openwindow;					)				)			),			V List Box(				golb1 = outlinebox("Distribution of Sample Data",					gb1 = graph box(frame size(450,150), xname(parmval[3]), yscale(0, num(parmval[4])/2), xscale(mn-4*stdv, mn+4*stdv))				),				ciolb = outline box("Sample Confidence Interval",					cihlb = h list box(						number col box("      Sample", {.}),						number col box("     Estimate", {.}),						if(use_sigma, numbercolbox("Sample Std Dev", {.})),						number col box("      Lower CI", {.}),						number col box("     Upper CI", {.}),						number col box("         Alpha", {1-conf}),						number col box("         Sigma", {sigma})					),					<< close(1)				),				golb3 = outline box("Confidence Intervals for the Population Mean",					gb3 = graph box(						framesize(450,150), 						xname("Sample Number"),						yscale(mn-8*stdv/sqrt(n), mn+8*stdv/sqrt(n)),						hline(mn);					)				),				mstolb = outline box("Means Summary Table",					lineupbox(ncol(2),						textbox("Mean of Sample Means:"),						msttb1 = textbox("."),						textbox("Std Dev of Sample Means:  "),						msttb2 = textbox("."),						textbox("No. of Sample Means:"),						msttb3 = textbox(".")					)				),				outlinebox("Percentage of Confidence Intervals Containing the Population Mean",					cipcttb = Textbox(". %Include Population Mean")				)			),			V list box(				sstolb = outline box("Sample Summary Table",					lineupbox(ncol(2),						textbox("Mean:"),						ssttb1 = textbox("."),						textbox("Std Dev  :  "),						ssttb2 = textbox("."),						textbox("Sample:"),						ssttb3 = textbox(".")					)				)			)		)	);	golb1[axisbox(1)]<<removeaxislabel;	golb3[axisbox(1)]<<removeaxislabel;	rb2 << set(2); animate_f = 0;);openwindow;